# Database
# Local/Docker development:
DB_URL=jdbc:postgresql://localhost:5432/autism
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here

# Render deployment:
# Do not copy the localhost DB_URL above to Render.
# Add Render/Neon PostgreSQL connection URL as DATABASE_URL; application converts it to JDBC.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (generate with: openssl rand -base64 64)
JWT_SECRET=your-very-long-random-secret-key-here
JWT_ACCESS_EXP=900000
JWT_REFRESH_EXP=604800000

# AI
GEMINI_API_KEY=your_gemini_api_key_here

# File Upload
UPLOAD_DIR=uploads
STORAGE_TYPE=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Encryption — en az 32 karakterlik rastgele anahtar
ENCRYPTION_KEY=your-32-char-encryption-key-here
ENCRYPTION_PREVIOUS_KEYS=
REQUIRE_EMAIL_VERIFICATION=true
TURNSTILE_REQUIRED=true
TURNSTILE_SECRET_KEY=

# CORS — production'da gerçek domain
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Server
PORT=8080
LOG_LEVEL=INFO

# Mail / SMTP — şifre sıfırlama ve bildirim e-postaları için zorunlu
# SendGrid: MAIL_HOST=smtp.sendgrid.net, MAIL_USERNAME=apikey, MAIL_PASSWORD=SG.xxx
# Mailgun: MAIL_HOST=smtp.eu.mailgun.org, MAIL_USERNAME=postmaster@mg.domain.com
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=

# VAPID — Web Push Bildirimleri
# Üretmek için: npx web-push generate-vapid-keys
# Public key frontend .env.example'daki VITE_VAPID_PUBLIC_KEY ile eşleşmeli.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@otizmdestek.com

# Firebase Cloud Messaging — Mobil Push Bildirimleri
# Firebase Console → Project Settings → Service accounts → Generate new private key
# ile indirilen JSON dosyasını base64'e çevirip buraya yapıştırın:
#   base64 -i service-account.json | tr -d '\n'
FIREBASE_ENABLED=true
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
