# ── Otizm Destek Platformu — Production Ortam Değişkenleri ───────────────────
# Bu dosyayı .env olarak kopyalayın ve tüm değerleri doldurun.
# .env asla Git'e commit edilmemeli.
#
# Kullanım: docker compose -f docker-compose.prod.yml up -d --build

# ── Veritabanı ────────────────────────────────────────────────────────────────
# Docker Compose için:
DB_USERNAME=autism_user
DB_PASSWORD=guclu-bir-sifre-girin

# Render için backend servisinin Environment bölümüne Render PostgreSQL
# "Internal Database URL" değerini DATABASE_URL olarak ekleyin; backend bunu JDBC biçimine dönüştürür.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME

# ── Güvenlik ──────────────────────────────────────────────────────────────────
# openssl rand -base64 64   komutuyla üretin
JWT_SECRET=

# En az 32 karakterlik rastgele anahtar
ENCRYPTION_KEY=
# Anahtar rotasyonunda eski anahtarları virgülle ayırın; yeniden şifreleme bitince kaldırın
ENCRYPTION_PREVIOUS_KEYS=

# Günlük pg_dump yedeklerinin AES-256 parolası (ENCRYPTION_KEY'den farklı olmalı)
BACKUP_ENCRYPTION_PASSWORD=
BACKUP_RETENTION_DAYS=30

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=

# ── Domain / CORS ─────────────────────────────────────────────────────────────
# Sitenizin gerçek adresi (https dahil, sonda / olmadan)
FRONTEND_URL=https://yourdomain.com
CORS_ORIGINS=https://yourdomain.com

# Cloudflare Turnstile (üretimde true yapın; site key frontend build'ine de verilir)
TURNSTILE_REQUIRED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare R2 / S3 uyumlu özel nesne deposu
STORAGE_TYPE=s3
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=otizm-private
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Mail / SMTP — şifre sıfırlama, e-posta doğrulama ve bildirim e-postaları için
# -------------------------------------------------------------------
# MAIL_ENABLED=false → SMTP yapılandırılmadan uygulama çalışır (geliştirme modu)
# MAIL_ENABLED=true  → Gerçek e-posta gönderimi aktif (production)
MAIL_ENABLED=true
MAIL_FROM_NAME=Otizm Destek Platformu

# ── Gmail (2FA açık + App Password gerekli) ──
# Google Hesabı → Güvenlik → Uygulama Şifreleri → "Mail" için şifre üret
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=senin@gmail.com
# MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx   # 16 haneli App Password

# ── SendGrid (100 e-posta/gün ücretsiz) ──
# https://app.sendgrid.com/settings/api_keys
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=SG.xxxxxxxxxxxxxxxxxxxxxxxx

# ── Mailgun (100 e-posta/gün ücretsiz) ──
# https://app.mailgun.com/mg/sending/domains
# MAIL_HOST=smtp.eu.mailgun.org
# MAIL_PORT=587
# MAIL_USERNAME=postmaster@mg.yourdomain.com
# MAIL_PASSWORD=mailgun_smtp_password

# ── Resend (3000 e-posta/ay ücretsiz, önerilen) ──
# https://resend.com/api-keys
# MAIL_HOST=smtp.resend.com
# MAIL_PORT=587
# MAIL_USERNAME=resend
# MAIL_PASSWORD=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Aktif SMTP ayarları (yukarıdan birini uncomment edip doldurun):
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Bildirim tercihleri
MAIL_NOTIFY_APPOINTMENT=true   # randevu bildirimlerinde e-posta gönder
MAIL_NOTIFY_MESSAGE=false      # mesaj bildirimlerinde e-posta gönder (spam riski)

# ── Web Push Bildirimleri (VAPID) ─────────────────────────────────────────────
# Üretmek için: npx web-push generate-vapid-keys
# Public key aynı zamanda frontend build'ine de verilmeli (VITE_VAPID_PUBLIC_KEY)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com

# ── Mobil Push Bildirimleri (Firebase Cloud Messaging) ────────────────────────
# Firebase Console → Project Settings → Service accounts → Generate new private key
# ile indirilen JSON dosyasını base64'e çevirip buraya yapıştırın:
#   base64 -i service-account.json | tr -d '\n'
# Bu anahtar asla Git'e commit edilmemeli, sadece sunucudaki .env'de tutulmalı.
FIREBASE_ENABLED=true
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# ── AI ────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
