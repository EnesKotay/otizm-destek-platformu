# ── Otizm Destek Platformu — Production Ortam Değişkenleri ───────────────────
# Bu dosyayı .env olarak kopyalayın ve tüm değerleri doldurun.
# .env asla Git'e commit edilmemeli.
#
# Kullanım: docker compose -f docker-compose.prod.yml up -d --build

# ── Veritabanı ────────────────────────────────────────────────────────────────
DB_USERNAME=autism_user
DB_PASSWORD=guclu-bir-sifre-girin

# ── Güvenlik ──────────────────────────────────────────────────────────────────
# openssl rand -base64 64   komutuyla üretin
JWT_SECRET=

# Tam olarak 32 karakter olmalı
# openssl rand -base64 32 | head -c 32
ENCRYPTION_KEY=

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=

# ── Domain / CORS ─────────────────────────────────────────────────────────────
# Sitenizin gerçek adresi (https dahil, sonda / olmadan)
FRONTEND_URL=https://yourdomain.com
CORS_ORIGINS=https://yourdomain.com

# ── Mail / SMTP ───────────────────────────────────────────────────────────────
# SendGrid: smtp.sendgrid.net / Mailgun: smtp.eu.mailgun.org
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=SG.xxxxxxxxxxxxxxxxxxxxxxxx

# ── Web Push Bildirimleri (VAPID) ─────────────────────────────────────────────
# Üretmek için: npx web-push generate-vapid-keys
# Public key aynı zamanda frontend build'ine de verilmeli (VITE_VAPID_PUBLIC_KEY)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com

# ── AI ────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
