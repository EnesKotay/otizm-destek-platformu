# ── Frontend Ortam Değişkenleri ──────────────────────────────────────
# Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun.
# .env.local hiçbir zaman Git'e commit edilmemelidir.

# Backend base URL.
# Local geliştirme: http://localhost:8080
# Vercel production: https://your-backend.onrender.com
# /api yazarsanız korunur; yazmazsanız uygulama otomatik /api ekler.
VITE_API_URL=http://localhost:8080

# WebSocket base URL.
# Boş bırakılırsa VITE_API_URL üzerinden /ws olarak türetilir.
VITE_WS_URL=http://localhost:8080/ws

# VAPID Public Key — Web Push bildirimleri için zorunlu.
# Üretmek için: npx web-push generate-vapid-keys
# Üretilen public key'i buraya, private key'i backend .env'e koyun.
# Production'da bu değer .env.example (proje kökü) ile senkron olmalı.
VITE_VAPID_PUBLIC_KEY=
